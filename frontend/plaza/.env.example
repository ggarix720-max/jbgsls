# =============================================================================
# 智能体广场（frontend/plaza）环境变量模板
#
# 本地开发：复制为 frontend/plaza/.env.local（或 .env）后按需填写，重启 dev server 生效。
# Docker 部署：NEXT_PUBLIC_* 为构建期内联，需在根目录 .env 中设置同名变量，
#             由 docker-compose.yml 的 build.args 注入，重新 `docker compose up -d --build` 生效。
#
# 所有项均可留空：代码内都有默认值（数字人见 src/views/digital-human/avatar.config.ts）。
# =============================================================================

# ---- 路径与后端 ----

# 站点挂载前缀（与 SvelteKit 同源入口一致，默认 /agents）
NEXT_PUBLIC_BASE_PATH=/agents

# FastAPI 后端地址（服务端路由转发用，本地默认 http://127.0.0.1:8000）
GRAIN_API_BASE_URL=

# webui 地址（登录等鉴权代理用，本地默认 http://127.0.0.1:8080）
WEBUI_BASE_URL=

# ---- 数字人（讯飞 Avatar Web SDK，浏览器 WebSocket 直连） ----
# 讯飞开放平台「数字人交互」服务凭证；留空则使用 avatar.config.ts 内默认值。

NEXT_PUBLIC_XF_AVATAR_SCENE_ID=
NEXT_PUBLIC_XF_AVATAR_APP_ID=
NEXT_PUBLIC_XF_AVATAR_API_KEY=
NEXT_PUBLIC_XF_AVATAR_API_SECRET=

# WebSocket 网关（默认华东一区 wss://avatar.cn-huadong-1.xf-yun.com/v1/interact）
NEXT_PUBLIC_XF_AVATAR_SERVER_URL=

# 数字人形象 ID / 音色 / 推流协议（xrtc | webrtc）
NEXT_PUBLIC_XF_AVATAR_ID=
NEXT_PUBLIC_XF_AVATAR_VCN=
NEXT_PUBLIC_XF_AVATAR_PROTOCOL=

# ---- 数字人大模型通道 ----

# knowledge = 项目知识库链路（/v1/chat）；assistant = 星火助手（/v1/assistant/chat）
NEXT_PUBLIC_XF_AVATAR_LLM_CHANNEL=

# 星火助手 ID，仅 channel=assistant 时必填；
# 同时需在后端根目录 .env 配置 XF_ASSISTANT_APP_ID / XF_ASSISTANT_API_KEY / XF_ASSISTANT_API_SECRET
NEXT_PUBLIC_XF_ASSISTANT_ID=
